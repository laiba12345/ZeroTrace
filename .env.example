DATABASE_URL="postgresql://user:password@host:5432/dbname"
# LLM_PROVIDER: "anthropic" (default) or "openai". LLM_MODEL must match the
# chosen provider (e.g. "claude-sonnet-5" for anthropic, "gpt-4o-mini" for openai).
LLM_PROVIDER="anthropic"
LLM_API_KEY=
LLM_MODEL="claude-sonnet-5"

GITHUB_API_BASE_URL="https://api.github.com"
GITHUB_TOKEN=
GITHUB_ORG=

SLACK_API_BASE_URL="https://slack.com/api"
SLACK_BOT_TOKEN=

GOOGLE_DRIVE_API_BASE_URL="https://www.googleapis.com"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

INTENT_CONFIDENCE_THRESHOLD=0.90
PROVIDER_READ_TIMEOUT_MS=10000

# REQUIRED for any public deployment — gates the whole app behind a single
# shared passcode (see /login). Unset only for trusted local/dev use.
ZEROTRACE_OPERATOR_SESSION_SECRET=

# Optional: overrides the UI's one-click demo preset text. Identity is never
# inferred from a name alone, so include a real, resolvable email matching
# whatever subject you seeded (see scripts/seed-sandbox.md).
NEXT_PUBLIC_DEMO_INSTRUCTION=

# --- Used only by scripts/seed.ts (not read by the app itself) ---
# Alice and Bob must be real accounts you control: a GitHub user, a member
# of your sandbox Slack workspace, and a Google account, all reachable at
# the emails below. See scripts/seed-sandbox.md.
ALICE_EMAIL=
ALICE_NAME="Alice Smith"
ALICE_GITHUB_LOGIN=
ALICE_GITHUB_TOKEN=
ALICE_SLACK_USER_TOKEN=

BOB_EMAIL=
BOB_NAME="Bob Lee"
BOB_GITHUB_LOGIN=
